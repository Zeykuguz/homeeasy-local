<Window x:Class="HomeEasy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeEasy Local – Cooper&amp;Hunter AC" Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontSize="14" Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,8,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="AC IP" Style="{StaticResource Label}"/>
            <ComboBox x:Name="HostBox" Grid.Column="1" IsEditable="True"/>
            <Button x:Name="DiscoverButton" Grid.Column="2" Content="Discover" Click="Discover_Click"/>
            <Button x:Name="ConnectButton" Grid.Column="3" Content="Connect" Click="Connect_Click"/>
        </Grid>

        <Border x:Name="ControlsPanel" Margin="0,12,0,0" Padding="14" Background="White" CornerRadius="8" IsEnabled="False">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Indoor" Foreground="#777"/>
                        <TextBlock x:Name="IndoorText" Text="--.- °C" FontSize="34" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ToggleButton x:Name="PowerButton" Grid.Column="1" Width="90" Height="56" FontSize="18" FontWeight="Bold"
                                  Content="OFF" Click="Power_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,6">
                    <Button Content="−" Width="52" Height="52" FontSize="26" Click="TempDown_Click"/>
                    <StackPanel Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="Target" Foreground="#777" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SetpointText" Text="-- °C" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="+" Width="52" Height="52" FontSize="26" Click="TempUp_Click"/>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mode" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ModeBox" Grid.Column="1" SelectionChanged="Mode_Changed"/>
                    <TextBlock Grid.Row="1" Text="Fan" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="FanBox" Grid.Row="1" Grid.Column="1" SelectionChanged="Fan_Changed"/>
                    <TextBlock Grid.Row="2" Text="Vertical swing" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="VSwingBox" Grid.Row="2" Grid.Column="1" SelectionChanged="VSwing_Changed"/>
                    <TextBlock Grid.Row="3" Text="Horizontal swing" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="HSwingBox" Grid.Row="3" Grid.Column="1" SelectionChanged="HSwing_Changed"/>
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <CheckBox x:Name="EcoBox" Content="Eco" Click="Flag_Click"/>
                    <CheckBox x:Name="SleepBox" Content="Sleep" Click="Flag_Click"/>
                    <CheckBox x:Name="DisplayBox" Content="Display" Click="Flag_Click"/>
                    <CheckBox x:Name="HealthBox" Content="Health" Click="Flag_Click"/>
                    <CheckBox x:Name="AuxBox" Content="Aux heat / Dry" Click="Flag_Click"/>
                </WrapPanel>

                <Border Margin="0,10,0,0" Padding="8" Background="#F0F4FA" CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Turn off after" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="TimerBox" Width="110" IsEditable="True"/>
                            <Button Content="Start" Click="TimerStart_Click"/>
                            <Button Content="Cancel" Click="TimerCancel_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TimerText" Margin="2,4,0,0" Foreground="#555" Text="Off timer: not set"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Margin="2,10,0,0" Foreground="#666" TextWrapping="Wrap" Text="Not connected"/>
    </StackPanel>
</Window>
